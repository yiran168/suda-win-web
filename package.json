{
  "name": "qrint-studio",
  "version": "1.0.0",
  "private": true,
  "description": "素打 · 桌面端 —— 58mm 热敏打印机创作工具（蓝牙 SPP）",
  "main": "electron/main.cjs",
  "author": "Qrint Studio",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win dir",
    "dist:zip": "npm run dist:dir && powershell -NoProfile -Command \"Compress-Archive -Path 'release\\win-unpacked\\*' -DestinationPath 'release\\素打-便携版.zip' -Force\""
  },
  "dependencies": {
    "bwip-js": "^4.11.2",
    "jsbarcode": "^3.12.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "~5.6.3",
    "vite": "^5.4.20"
  },
  "build": {
    "appId": "com.qrint.studio",
    "productName": "素打",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.ico",
      "assets/app-icon.png"
    ],
    "win": {
      "icon": "assets/app-icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "素打"
    }
  }
}
